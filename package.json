{
  "name": "camkit",
  "private": false,
  "version": "1.0.1",
  "description": "Framework-agnostic camera capture, photo processing, and upload SDK",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\" \"apps/**/*.{ts,tsx,js,jsx,json,md}\"",
    "docs": "typedoc",
    "release": "npm publish --access public"
  },
  "keywords": [
    "camera",
    "sdk",
    "image-processing",
    "upload",
    "webgl",
    "react",
    "vue",
    "typescript"
  ],
  "author": "CamKit Team",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}